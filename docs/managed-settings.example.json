{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.envrc)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.pypirc)",
      "Read(~/.gnupg/**)",
      "Read(~/.password-store/**)",
      "Read(~/.git-credentials)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.terraform.d/**)",
      "Read(~/.vault-token)",
      "Read(~/.cargo/credentials*)",
      "Read(~/.composer/auth.json)",
      "Read(~/.config/composer/auth.json)",
      "Read(~/.m2/settings.xml)",
      "Read(~/.claude.json)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.envrc)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.development)",
      "Edit(**/.env.test)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(npm publish:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "enabledPlatforms": [
      "macos",
      "linux",
      "wsl"
    ],
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "denyRead": [
        "~/.docker",
        "~/.bash_history",
        "~/.zsh_history",
        "~/.local/share/keyrings",
        "~/.mozilla",
        "~/.config/google-chrome",
        "~/Library/Keychains",
        "~/Library/Application Support/Google/Chrome",
        "~/Library/Application Support/Firefox",
        "**/.env.*"
      ],
      "allowRead": [
        "**/.env.example",
        "**/.env.sample",
        "**/.env.template",
        "**/.env.dist"
      ],
      "denyWrite": [
        "./CLAUDE.md",
        "./.mcp.json",
        "./.claude",
        "./.github",
        "./.git/hooks",
        "./.git/config",
        "./.pre-commit-config.yaml",
        "./SECURITY.md",
        "./.gitleaksignore",
        "./osv-scanner.toml",
        "./.semgrepignore",
        "./.trivyignore"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_AUTH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "CLAUDE_CODE_OAUTH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_MCP_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITLAB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NODE_AUTH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "TWINE_PASSWORD",
          "mode": "deny"
        },
        {
          "name": "CARGO_REGISTRY_TOKEN",
          "mode": "deny"
        },
        {
          "name": "COMPOSER_AUTH",
          "mode": "deny"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        },
        {
          "name": "AZURE_CLIENT_SECRET",
          "mode": "deny"
        },
        {
          "name": "GOOGLE_APPLICATION_CREDENTIALS",
          "mode": "deny"
        },
        {
          "name": "OPENAI_API_KEY",
          "mode": "deny"
        },
        {
          "name": "HF_TOKEN",
          "mode": "deny"
        },
        {
          "name": "VAULT_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
  "env": {
    "DISABLE_TELEMETRY": "1"
  }
}
